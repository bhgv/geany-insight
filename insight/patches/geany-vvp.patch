+// EN: Find a living process by its session-local identifier.
+// RU: Ищем существующий процесс по идентификатору сеанса.
+static vthread_t geany_find_process(unsigned long long process)
+{
+      const auto found = geany_processes.find(process);
+      if (found == geany_processes.end() || found->second->i_have_ended)
+            return nullptr;
+      return found->second;
