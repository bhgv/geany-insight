+// EN: Snapshot static HDL objects at the stop prompt. Arguments are unused.
+// RU: Снимает значения статических объектов HDL на паузе. Аргументы не используются.
+static void cmd_geany_signals(unsigned, const char*[])
+{
+      if (!geany_debug_enabled())
+            return;
+      printf("\nGEANY-SIGNALS-BEGIN\t%" TIME_FMT_U "\n", schedule_simtime());
+      unsigned remaining = 4096;
+      const vpi_mode_t previous_mode = vpi_mode_flag;
+      vpi_mode_flag = VPI_MODE_ROSYNC;
+      vpiHandle roots = vpi_iterate(vpiModule, nullptr);
+      if (roots) {
+            while (vpiHandle root = vpi_scan(roots)) {
+                  if (!remaining) {
+                        vpi_free_object(roots);
+                        break;
+                  }
+                  geany_signal_scope(root, {}, 0, remaining);
+            }
+      }
+      vpi_mode_flag = previous_mode;
+      printf("GEANY-SIGNALS-END\t%s\n", remaining ? "complete" : "limited");
+}
