+// EN: Change inspection frame without changing the process used for stepping.
+// RU: Меняет кадр просмотра, сохраняя процесс для пошагового выполнения.
+static void cmd_geany_select_frame(unsigned argc, const char* argv[])
+{
+      if (!geany_debug_enabled() || argc != 2)
+            return;
+      std::istringstream number(argv[1]);
+      unsigned depth = 0;
+      if (argv[1][0] < '0' || argv[1][0] > '9' ||
+          !(number >> depth) || !number.eof() || depth >= 64) {
+            printf("Geany: expected a frame number from 0 to 63.\n");
+            return;
+      }
+      __vpiScope* scope = geany_inspect_frame(geany_stopped_process, depth);
+      if (!scope) {
+            printf("Geany: frame %u is unavailable.\n", depth);
+            return;
+      }
+      geany_frame_depth = depth;
+      stop_current_scope = scope;
+}
