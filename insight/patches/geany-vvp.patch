+      printf("GEANY-SIGNAL-STOP-ON\t%s\t%s\t%s\n", path.c_str(), mode.c_str(), mask.c_str());
+}
+
+// EN: Deposit bits into a static integral variable while the scheduler waits.
+// argc and argv contain the command, variable path and exact-width binary value.
+// RU: Записывает биты в статическую целую переменную на паузе планировщика.
+// argc и argv содержат команду, путь переменной и двоичное значение полной ширины.
+static void cmd_geany_write_register(unsigned argc, const char* argv[])
+{
+      if (!geany_debug_enabled())
+            return;
+      if (argc != 3) {
+            printf("Geany: expected geany-write-register <path> <bits>.\n");
+            return;
+      }
+      const std::string bits(argv[2]);
+      if (bits.empty() || bits.find_first_not_of("01xz") != std::string::npos) {
+            printf("Geany: expected binary digits 0, 1, x or z.\n");
+            return;
+      }
+
+      const vpi_mode_t previous_mode = vpi_mode_flag;
+      if (previous_mode == VPI_MODE_NONE)
+            vpi_mode_flag = VPI_MODE_ROSYNC;
+      vpiHandle signal = vpi_handle_by_name(argv[1], nullptr);
+      if (!signal && stop_current_scope && !std::strchr(argv[1], '.'))
+            signal = vpi_handle_by_name(argv[1], stop_current_scope);
+      vpi_mode_flag = previous_mode;
+      if (!signal ||
+          (vpi_get(vpiType, signal) != vpiReg && vpi_get(vpiType, signal) != vpiIntegerVar) ||
+          vpi_get(vpiAutomatic, signal) == 1 ||
+          vpi_get(vpiSize, signal) != static_cast<int>(bits.size())) {
+            printf("Geany: expected a static register or integer and its exact bit width: %s\n", argv[1]);
+            return;
+      }
+
+      s_vpi_value value = {};
+      value.format = vpiBinStrVal;
+      value.value.str = const_cast<char*>(bits.c_str());
+      vpi_put_value(signal, &value, nullptr, vpiNoDelay);
+
+      value.value.str = nullptr;
+      vpi_get_value(signal, &value);
+      if (!value.value.str || bits != value.value.str)
+            printf("Geany: write did not take effect: %s\n", argv[1]);
+      else
+            printf("Geany: %s = %s\n", argv[1], value.value.str);
+}
