+// EN: Read values in the exact selected scope and activation.
+// RU: Читаем значения выбранной области и её активации.
+void geany_list_process_values(unsigned long long process, unsigned depth)
+{
+      vthread_t thread = geany_find_frame(process, depth);
+      if (!thread || !vthread_scope(thread)) {
+            printf("Geany: select a live process first.\n");
+            return;
+      }
+      __vpiScope* scope = vthread_scope(thread);
+      vthread_t previous = running_thread;
+      running_thread = thread;
+      const bool exact_context = thread->rd_context && thread->rd_context == thread->wt_context;
+      unsigned count = 0;
+      for (vpiHandle signal : scope->intern) {
+            const int type = vpi_get(vpiType, signal);
+            const bool integral = dynamic_cast<__vpiSignal*>(signal) != nullptr;
+            const bool array = type == vpiArrayVar;
+            if (!integral && !array && type != vpiMemory &&
+                type != vpiRealVar && type != vpiStringVar)
+                  continue;
+            if (scope->is_automatic() && !exact_context)
+                  continue;
+            if (integral && vpi_get(vpiSize, signal) > 4096)
+                  continue;
+            if (count++ == 128) {
+                  printf("Geany: value list limited to 128 entries.\n");
+                  break;
+            }
+            const char* name = geany_value_name(signal);
+            printf("%s", name ? name : "(unnamed)");
+            if (type == vpiMemory) {
+                  printf(" [memory]\n");
+                  continue;
+            }
+            if (array) {
+                  const char* kind = vpi_get(vpiArrayType, signal) == vpiQueueArray ?
+                        "queue" : "dynamic array";
+                  printf(" [%s, %d elements]\n", kind, vpi_get(vpiSize, signal));
+                  continue;
+            }
+            s_vpi_value value = {};
+            value.format = integral ? vpiBinStrVal :
+                  type == vpiRealVar ? vpiRealVal : vpiStringVal;
+            vpi_get_value(signal, &value);
+            printf(" = ");
+            if (value.format == vpiRealVal) {
+                  printf("%.17g", value.value.real);
+            } else if (value.format == vpiStringVal && value.value.str) {
+                  geany_print_string(value.value.str);
+            } else {
+                  printf("%s", value.format == vpiBinStrVal && value.value.str ?
+                         value.value.str : "(unavailable)");
+            }
+            putchar('\n');
+      }
+      running_thread = previous;
+}
+
+// EN: Switch the inspection scope to an existing frame.
+// RU: Переключает область просмотра на существующий кадр.
+__vpiScope* geany_inspect_frame(unsigned long long process, unsigned depth)
+{
