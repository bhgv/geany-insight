+// EN: Resolve a parent frame within the selected live process.
+// RU: Находит родительский кадр выбранного живого процесса.
+static vthread_t geany_find_frame(unsigned long long process, unsigned depth)
+{
+      vthread_t frame = geany_find_process(process);
+      while (frame && depth) {
+            frame = frame->parent;
+            --depth;
+      }
+      return frame && !frame->i_have_ended ? frame : nullptr;
