+enum class geany_watch_mode { change, rise, fall, unknown, mask };
+
+struct geany_watch {
+      std::string path, previous, mask;
+      geany_watch_mode mode;
+      vpiHandle callback;
+};
+
+static std::vector<geany_watch*> geany_watches;
+static bool geany_at_prompt = false;
+
+// EN: Check bits against pattern, where '?' skips a bit.
+// RU: Сравнивает bits с pattern, где '?' пропускает бит.
+static bool geany_watch_matches(const std::string& bits, const std::string& pattern)
+{
+      if (bits.size() != pattern.size())
+            return false;
+      for (std::size_t i = 0; i < bits.size(); i++)
+            if (pattern[i] != '?' && pattern[i] != bits[i])
+                  return false;
+      return true;
+}
+
+// EN: Check the transition from rule.previous to bits.
+// RU: Проверяет переход от rule.previous к bits.
+static bool geany_watch_transition(const geany_watch& rule, const std::string& bits)
+{
+      if (bits == rule.previous || bits.size() != rule.previous.size())
+            return false;
+      switch (rule.mode) {
+          case geany_watch_mode::change: return true;
+          case geany_watch_mode::rise: return rule.previous == "0" && bits == "1";
+          case geany_watch_mode::fall: return rule.previous == "1" && bits == "0";
+          case geany_watch_mode::mask:
+            return !geany_watch_matches(rule.previous, rule.mask) &&
+                   geany_watch_matches(bits, rule.mask);
+          case geany_watch_mode::unknown:
+            for (std::size_t i = 0; i < bits.size(); i++)
+                  if ((bits[i] == 'x' || bits[i] == 'z') && bits[i] != rule.previous[i])
+                        return true;
+            return false;
+      }
+      return false;
+}
+
+// EN: Observe the VPI event and stop after the current scheduler action.
+// RU: Проверяет событие event и останавливает планировщик после текущего действия.
+static PLI_INT32 geany_watch_changed(p_cb_data event)
+{
+      geany_watch* rule = const_cast<geany_watch*>(reinterpret_cast<const geany_watch*>(event->user_data));
+      if (!event->value || event->value->format != vpiBinStrVal || !event->value->value.str)
+            return 0;
+      const std::string bits(event->value->value.str);
+      if (!geany_at_prompt && geany_watch_transition(*rule, bits)) {
+            printf("Geany signal stop: %s %s -> %s\n", rule->path.c_str(),
+                   rule->previous.c_str(), bits.c_str());
+            printf("GEANY-SIGNAL-STOP-HIT\t%s\n", rule->path.c_str());
+            schedule_stop(0);
+      }
+      rule->previous = bits;
+      return 0;
+}
+
+// EN: Remove the callback for the watch at index.
+// RU: Удаляет обратный вызов наблюдения с индексом index.
+static void geany_watch_remove(std::size_t index)
+{
+      geany_watch* rule = geany_watches[index];
+      vpi_remove_cb(rule->callback);
+      geany_watches.erase(geany_watches.begin() + index);
+      delete rule;
+}
+
+// EN: Add or replace the watch specified by argc/argv at the pause prompt.
+// RU: Создаёт или заменяет наблюдение из argc/argv на паузе.
+static void cmd_geany_watch_signal(unsigned argc, const char* argv[])
+{
+      if (!geany_debug_enabled() || argc < 3 || argc > 4)
+            return;
+      const std::string path(argv[1]), mode(argv[2]), mask(argc == 4 ? argv[3] : "");
+      std::size_t index = 0;
+      while (index < geany_watches.size() && geany_watches[index]->path != path)
+            ++index;
+      if (mode == "off") {
+            if (index < geany_watches.size())
+                  geany_watch_remove(index);
+            printf("Geany: signal stop cleared: %s\n", path.c_str());
+            printf("GEANY-SIGNAL-STOP-OFF\t%s\n", path.c_str());
+            return;
+      }
+
+      geany_watch_mode kind;
+      if (mode == "change") kind = geany_watch_mode::change;
+      else if (mode == "rise") kind = geany_watch_mode::rise;
+      else if (mode == "fall") kind = geany_watch_mode::fall;
+      else if (mode == "unknown") kind = geany_watch_mode::unknown;
+      else if (mode == "mask") kind = geany_watch_mode::mask;
+      else return;
+
+      if (index == geany_watches.size() && index >= 64) {
+            printf("Geany: limit of 64 signal stops reached.\n");
+            return;
+      }
+      const vpi_mode_t previous_mode = vpi_mode_flag;
+      vpi_mode_flag = VPI_MODE_ROSYNC;
+      vpiHandle signal = vpi_handle_by_name(path.c_str(), nullptr);
+      vpi_mode_flag = previous_mode;
+      const int type = signal ? vpi_get(vpiType, signal) : 0;
+      const int width = signal ? vpi_get(vpiSize, signal) : 0;
+      if ((type != vpiReg && type != vpiNet && type != vpiIntegerVar) ||
+          vpi_get(vpiAutomatic, signal) == 1 || width < 1 || width > 4096 ||
+          ((kind == geany_watch_mode::rise || kind == geany_watch_mode::fall) && width != 1) ||
+          (kind == geany_watch_mode::mask &&
+           (mask.size() != static_cast<std::size_t>(width) ||
+            mask.find_first_not_of("01xz?") != std::string::npos ||
+            mask.find_first_not_of('?') == std::string::npos))) {
+            printf("Geany: unsupported signal, edge width or mask: %s\n", path.c_str());
+            return;
+      }
+      s_vpi_value value = {};
+      value.format = vpiBinStrVal;
+      vpi_get_value(signal, &value);
+      if (value.format != vpiBinStrVal || !value.value.str)
+            return;
+      geany_watch* rule = new geany_watch{path, value.value.str, mask, kind, nullptr};
+      s_vpi_value callback_value = {};
+      callback_value.format = vpiBinStrVal;
+      s_vpi_time callback_time = {};
+      callback_time.type = vpiSuppressTime;
+      s_cb_data callback = {};
+      callback.reason = cbValueChange;
+      callback.cb_rtn = geany_watch_changed;
+      callback.obj = signal;
+      callback.value = &callback_value;
+      callback.time = &callback_time;
+      callback.user_data = reinterpret_cast<decltype(callback.user_data)>(rule);
+      rule->callback = vpi_register_cb(&callback);
+      if (!rule->callback) {
+            delete rule;
