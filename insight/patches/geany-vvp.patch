+// EN: Select a live process and show its task or fork ancestry.
+// RU: Выбираем живой процесс и показываем цепочку его задач или fork.
+__vpiScope* geany_inspect_process(unsigned long long process)
+{
+      vthread_t thread = geany_find_process(process);
+      if (!thread)
+            return nullptr;
+      unsigned depth = 0;
+      for (vthread_t frame = thread; frame && depth < 64; frame = frame->parent) {
+            printf("Frame %u: ", depth++);
+            geany_print_process(frame);
+      }
+      return vthread_scope(thread);
+}
+
+static void geany_print_string(const std::string& value)
+{
+      putchar('"');
+      unsigned length = 0;
+      for (const unsigned char* byte =
+                 reinterpret_cast<const unsigned char*>(value.data());
+           length < value.size() && length < 4096; ++byte, ++length) {
+            if (*byte == '"' || *byte == '\\')
+                  printf("\\%c", *byte);
+            else if (*byte < 32 || *byte >= 127)
+                  printf("\\x%02x", static_cast<unsigned>(*byte));
+            else
+                  putchar(*byte);
+      }
+      printf(length < value.size() ? "\"..." : "\"");
+}
+
+// Some SystemVerilog handles store a name without implementing vpiName.
+static const char* geany_value_name(vpiHandle handle)
+{
+      if (auto* variable = dynamic_cast<__vpiBaseVar*>(handle))
+            return variable->get_name();
+      return vpi_get_str(vpiName, handle);
+}
+
+static bool geany_print_array_word(vpiHandle handle, const char* name, int index)
+{
+      auto* variable = dynamic_cast<__vpiBaseVar*>(handle);
+      auto* signal = variable ?
+            dynamic_cast<vvp_fun_signal_object*>(variable->get_net()->fun) : nullptr;
+      if (!signal || index < 0)
+            return false;
+      // Read the current object directly so resizing or replacing the array
+      // does not leave the debugger with a stale VPI word handle.
+      vvp_object_t object = signal->get_object();
+      auto* array = object.peek<vvp_darray>();
+      if (!array || static_cast<unsigned>(index) >= array->get_size())
+            return false;
+
+      printf("%s[%d] = ", name, index);
+      if (dynamic_cast<vvp_darray_real*>(array) || dynamic_cast<vvp_queue_real*>(array)) {
+            double value;
+            array->get_word(index, value);
+            printf("%.17g", value);
+      } else if (dynamic_cast<vvp_darray_string*>(array) ||
+                 dynamic_cast<vvp_queue_string*>(array)) {
+            std::string value;
+            array->get_word(index, value);
+            geany_print_string(value);
+      } else if (dynamic_cast<vvp_darray_object*>(array)) {
+            printf("(object)");
+      } else {
+            vvp_vector4_t value;
+            array->get_word(index, value);
+            if (value.size() > 4096)
+                  printf("(unavailable)");
+            else
+                  for (unsigned bit = value.size(); bit > 0; --bit)
+                        putchar(vvp_bit4_to_ascii(value.value(bit - 1)));
+      }
+      putchar('\n');
+      return true;
+}
