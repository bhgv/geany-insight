+      geany_print_process(frame);
+      return vthread_scope(frame);
+}
+
+// EN: Read one indexed memory word in the selected frame.
+// RU: Читает один элемент памяти по индексу в выбранном кадре.
+void geany_read_memory(unsigned long long process, unsigned depth, const char* name, int index)
+{
+      vthread_t frame = geany_find_frame(process, depth);
+      __vpiScope* scope = frame ? vthread_scope(frame) : nullptr;
+      if (!scope) {
+            printf("Geany: select an available frame first.\n");
+            return;
+      }
+      if (scope->is_automatic() && (!frame->rd_context || frame->rd_context != frame->wt_context)) {
+            printf("Geany: this frame has no matching automatic context.\n");
+            return;
+      }
+
+      for (vpiHandle memory : scope->intern) {
+            const int memory_type = vpi_get(vpiType, memory);
+            if (memory_type != vpiMemory && memory_type != vpiArrayVar)
+                  continue;
+            const char* memory_name = geany_value_name(memory);
+            if (!memory_name || std::strcmp(memory_name, name))
+                  continue;
+
+            if (memory_type == vpiArrayVar) {
+                  vthread_t previous = running_thread;
+                  running_thread = frame;
+                  const bool found = geany_print_array_word(memory, name, index);
+                  running_thread = previous;
+                  if (!found)
+                        printf("Geany: array element unavailable: %s[%d]\n", name, index);
+                  return;
+            }
+
+            s_vpi_value left = {}, right = {};
+            left.format = right.format = vpiIntVal;
+            vpiHandle left_bound = vpi_handle(vpiLeftRange, memory);
+            vpiHandle right_bound = vpi_handle(vpiRightRange, memory);
+            if (left_bound && right_bound) {
+                  vpi_get_value(left_bound, &left);
+                  vpi_get_value(right_bound, &right);
+                  const int first = left.value.integer;
+                  const int last = right.value.integer;
+                  if ((index >= first && index <= last) || (index >= last && index <= first)) {
+                        vthread_t previous = running_thread;
+                        running_thread = frame;
+                        vpiHandle word = vpi_handle_by_index(memory, index);
+                        const int type = word ? vpi_get(vpiType, word) : 0;
+                        if ((type == vpiNet || type == vpiReg || type == vpiMemoryWord) &&
+                            vpi_get(vpiSize, word) <= 4096) {
+                              s_vpi_value value = {};
+                              value.format = vpiBinStrVal;
+                              vpi_get_value(word, &value);
+                              printf("%s[%d] = %s\n", name, index,
+                                     value.format == vpiBinStrVal && value.value.str ?
+                                           value.value.str : "(unavailable)");
+                              running_thread = previous;
+                              return;
+                        }
+                        running_thread = previous;
+                  }
+            }
+            printf("Geany: memory index or word unavailable: %s[%d]\n", name, index);
+            return;
+      }
+      printf("Geany: memory not found in this frame: %s\n", name);
+}
