+{
+      const char* state = process->i_have_ended ? "ended" :
+            process->waiting_for_event ? "waiting for event" :
+            process->i_am_joining ? "joining children" :
+            process->is_scheduled ? "scheduled" : "suspended";
+      __vpiScope* current_scope = vthread_scope(process);
+      const char* scope = current_scope ? vpi_get_str(vpiFullName, current_scope) : nullptr;
+      printf("%llu  %s  %s  %s\n", process->geany_process_id, state,
+             scope ? scope : "(root)", process->get_fileline().c_str());
