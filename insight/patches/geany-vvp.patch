+// EN: List a bounded number of live simulation processes.
+// RU: Показываем ограниченное число живых процессов симуляции.
+void geany_list_processes()
+{
+      unsigned count = 0;
+      for (const auto& entry : geany_processes) {
+            if (entry.second->i_have_ended)
+                  continue;
+            if (count++ == 256) {
+                  printf("Geany: process list limited to 256 entries.\n");
+                  break;
+            }
+            geany_print_process(entry.second);
+      }
+}
