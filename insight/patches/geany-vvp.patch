+// EN: Select a live process as the inspection and stepping target.
+// RU: Выбираем живой процесс для просмотра и пошагового выполнения.
+static void cmd_geany_select_process(unsigned argc, const char* argv[])
+{
+      if (!geany_debug_enabled() || argc != 2)
+            return;
+      std::istringstream number(argv[1]);
+      unsigned long long process = 0;
+      if (argv[1][0] < '0' || argv[1][0] > '9' ||
+          !(number >> process) || !number.eof() || !process) {
+            printf("Geany: expected a positive process number.\n");
+            return;
+      }
+      __vpiScope* scope = geany_inspect_process(process);
+      if (!scope) {
+            printf("Geany: process %llu is no longer available.\n", process);
+            return;
+      }
+      geany_stopped_process = process;
+      geany_frame_depth = 0;
+      stop_current_scope = scope;
+}
