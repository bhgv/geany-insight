+// EN: Emit one bounded row for object, using signal as its value handle.
+// file identifies the defining module, kind selects the editor table.
+// RU: Выводит строку object со значением signal, файлом модуля file и типом kind.
+static void geany_signal_row(vpiHandle object, vpiHandle signal, const std::string& file, char kind)
+{
+      std::string name;
+      if (kind == 'P') {
+            const char* scope = vpi_get_str(vpiFullName, vpi_handle(vpiScope, object));
+            if (!scope)
+                  return;
+            name = scope;
+            const char* port = vpi_get_str(vpiName, object);
+            if (!port)
+                  return;
+            name += ".";
+            name += port;
+      } else {
+            const char* path = vpi_get_str(vpiFullName, object);
+            if (!path)
+                  return;
+            name = path;
+      }
+      if (name.size() > 1024 || name.find_first_of("\t\r\n") != std::string::npos ||
+          file.size() > 2048 || file.find_first_of("\t\r\n") != std::string::npos)
+            return;
+      s_vpi_value value = {};
+      value.format = vpiBinStrVal;
+      const int width = signal ? vpi_get(vpiSize, signal) : 0;
+      if (width > 0 && width <= 4096)
+            vpi_get_value(signal, &value);
+      printf("GEANY-SIGNAL\t%c\t%s\t%s\t%s\n", kind, name.c_str(), file.c_str(),
+             value.format == vpiBinStrVal && value.value.str ? value.value.str : "");
+}
+
+// EN: Walk scope and its children, inheriting file until a nested module.
+// depth and remaining bound recursion and the number of rows.
+// RU: Обходит scope и дочерние области, наследуя file до вложенного модуля.
+// depth и remaining ограничивают глубину и число строк.
+static void geany_signal_scope(vpiHandle scope, std::string file, unsigned depth, unsigned& remaining)
+{
+      if (depth >= 64 || !remaining)
+            return;
+      if (vpi_get(vpiType, scope) == vpiModule) {
+            const char* module_file = vpi_get_str(vpiDefFile, scope);
+            if (module_file)
+                  file = module_file;
+      }
+      const int types[] = {vpiPort, vpiNet, vpiReg, vpiIntegerVar};
+      for (int type : types) {
+            vpiHandle items = vpi_iterate(type, scope);
+            if (!items)
+                  continue;
+            while (vpiHandle object = vpi_scan(items)) {
+                  if (!remaining) {
+                        vpi_free_object(items);
+                        break;
+                  }
+                  if (type != vpiPort && vpi_get(vpiAutomatic, object) == 1)
+                        continue;
+                  vpiHandle signal = object;
+                  if (type == vpiPort) {
+                        const char* name = vpi_get_str(vpiName, object);
+                        const std::string port(name ? name : "");
+                        signal = port.empty() ? nullptr : vpi_handle_by_name(port.c_str(), scope);
+                  }
+                  geany_signal_row(object, signal, file,
+                                   type == vpiPort ? 'P' : type == vpiNet ? 'N' : 'R');
+                  --remaining;
+            }
+      }
+      vpiHandle children = vpi_iterate(vpiInternalScope, scope);
+      if (!children)
+            return;
+      while (vpiHandle child = vpi_scan(children)) {
+            if (!remaining) {
+                  vpi_free_object(children);
+                  break;
+            }
+            geany_signal_scope(child, file, depth + 1, remaining);
+      }
+}
