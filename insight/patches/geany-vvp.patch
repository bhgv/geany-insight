+// EN: Keep the Geany bridge inactive for ordinary vvp invocations.
+// RU: Оставляем мост Geany выключенным при обычном запуске vvp.
+static bool geany_debug_enabled()
+{
+      static const char* enabled = std::getenv("GEANY_VVP_DEBUG");
+      return enabled && std::strcmp(enabled, "1") == 0;
+}
+
+struct geany_breakpoint {
+      unsigned line;
+      std::string filename;
+      std::string signal, bits;
+      unsigned threshold, hits;
+      bool log_only, scripted, missing_reported;
+};
+
+static std::vector<geany_breakpoint> geany_breakpoints;
+
+// EN: Normalize the filename used by the compiler and by the editor.
+// RU: Нормализуем имя файла, полученное от компилятора и редактора.
+static std::string geany_file_key(const char* filename)
+{
+      std::string key(filename);
+#ifdef __MINGW32__
+      for (char& byte : key) {
+            if (byte == '\\')
+                  byte = '/';
+            else if (byte >= 'A' && byte <= 'Z')
+                  byte += 'a' - 'A';
+      }
+#endif
+      return key;
+}
+
+// EN: Reload the bounded source breakpoint list while the scheduler is stopped.
+// RU: Перечитываем ограниченный список точек, пока планировщик остановлен.
+static void cmd_geany_load(unsigned, const char*[])
+{
+      if (!geany_debug_enabled())
+            return;
+      std::ifstream input(".geany-vvp-breakpoints");
+      std::vector<geany_breakpoint> points;
+      std::string record;
+      while (points.size() < 128 && std::getline(input, record)) {
+            if (record.size() > 8192)
+                  continue;
+            std::vector<std::string> fields;
+            std::size_t start = 0;
+            for (std::size_t tab = record.find('\t'); tab != std::string::npos;
+                 tab = record.find('\t', start)) {
+                  fields.push_back(record.substr(start, tab - start));
+                  start = tab + 1;
+            }
+            fields.push_back(record.substr(start));
+            if ((fields.size() != 2 && fields.size() != 6 && fields.size() != 7) || fields[1].empty())
+                  continue;
+
+            std::istringstream number(fields[0]);
+            geany_breakpoint point = {};
+            if (!(number >> point.line) || !number.eof() || !point.line)
+                  continue;
+            point.filename = geany_file_key(fields[1].c_str());
+            point.threshold = 1;
+            if (fields.size() >= 6) {
+                  point.signal = fields[2];
+                  point.bits = fields[3];
+                  std::istringstream hits(fields[4]);
+                  if (!(hits >> point.threshold) || !hits.eof() ||
+                      !point.threshold || point.threshold > 1000000 ||
+                      (fields[5] != "0" && fields[5] != "1") ||
+                      point.signal.empty() != point.bits.empty() ||
+                      point.bits.find_first_not_of("01xz") != std::string::npos)
+                        continue;
+                  point.log_only = fields[5] == "1";
+                  if (fields.size() == 7) {
+                        if (fields[6] != "0" && fields[6] != "1")
+                              continue;
+                        point.scripted = fields[6] == "1";
+                  }
+            }
+
+            // EN: Preserve counters for unchanged rules.
+            // RU: Сохраняем счётчики неизменённых правил.
+            for (const geany_breakpoint& old : geany_breakpoints) {
+                  if (old.filename == point.filename && old.line == point.line &&
+                      old.signal == point.signal && old.bits == point.bits &&
+                      old.threshold == point.threshold && old.log_only == point.log_only &&
+                      old.scripted == point.scripted) {
+                        point.hits = old.hits;
+                        point.missing_reported = old.missing_reported;
+                        break;
+                  }
+            }
+            points.push_back(point);
+      }
+      geany_breakpoints.swap(points);
+      printf("Geany: %u source breakpoint(s).\n", static_cast<unsigned>(geany_breakpoints.size()));
+}
+
+// EN: Show the configured rules and their current matching-hit counters.
+// RU: Показываем правила и текущие счётчики совпадений.
+static void cmd_geany_list(unsigned, const char*[])
+{
+      if (!geany_debug_enabled())
+            return;
+      for (const geany_breakpoint& point : geany_breakpoints) {
+            printf("%s:%u %s hits=%u threshold=%u", point.filename.c_str(), point.line,
+                   point.log_only ? "log" : point.scripted ? "script" : "stop", point.hits, point.threshold);
+            if (!point.signal.empty())
+                  printf(" %s == %s", point.signal.c_str(), point.bits.c_str());
+            printf("\n");
+      }
+      printf("Geany: %u source breakpoint(s).\n", static_cast<unsigned>(geany_breakpoints.size()));
+}
+
+// EN: Read a four-state value without changing the design.
+// RU: Читаем четырёхсостоянийное значение без изменения схемы.
+static bool geany_signal_matches(geany_breakpoint& point)
+{
+      if (point.signal.empty())
+            return true;
+      vpiHandle signal = vpi_handle_by_name(point.signal.c_str(), nullptr);
+      if (!signal) {
+            if (!point.missing_reported) {
+                  printf("Geany: signal not found: %s\n", point.signal.c_str());
+                  point.missing_reported = true;
+            }
+            return false;
+      }
+      const int type = vpi_get(vpiType, signal);
+      if ((type != vpiNet && type != vpiReg && type != vpiIntegerVar && type != vpiMemoryWord) ||
+          vpi_get(vpiSize, signal) != static_cast<int>(point.bits.size())) {
+            if (!point.missing_reported) {
+                  printf("Geany: unsupported signal or wrong bit width: %s\n", point.signal.c_str());
+                  point.missing_reported = true;
+            }
+            return false;
+      }
+      s_vpi_value value = {};
+      value.format = vpiBinStrVal;
+      vpi_get_value(signal, &value);
+      return value.value.str && point.bits == value.value.str;
+}
+
+// EN: Match a source opcode against the current breakpoint list.
+// RU: Сопоставляем команду исходника с текущим списком точек.
+bool geany_source_breakpoint(const char* filename, unsigned line)
+{
+      if (geany_breakpoints.empty() || !filename)
+            return false;
+      const std::string key = geany_file_key(filename);
+      for (geany_breakpoint& point : geany_breakpoints) {
+            if (point.line != line || point.filename != key || !geany_signal_matches(point))
+                  continue;
+            if (point.hits < 0xffffffffu)
+                  point.hits++;
+            if (point.hits < point.threshold)
+                  continue;
+            if (point.log_only) {
+                  printf("Geany logpoint: %s:%u hit %u", filename, line, point.hits);
+                  if (!point.signal.empty())
+                        printf(" %s=%s", point.signal.c_str(), point.bits.c_str());
+                  printf("\n");
+                  continue;
+            }
+            if (point.scripted)
+                  printf("GEANY-VVP-EVENT\t%u\t%s\t%" TIME_FMT_U "\t%u\t%s\t%s\n",
+                         line, filename, schedule_simtime(), point.hits,
+                         point.signal.c_str(), point.bits.c_str());
+            printf("GEANY-VVP-STOP\t%u\t%s\n", line, filename);
+            return true;
+      }
+      return false;
+}
+
+// EN: Poll a private pause marker at bounded intervals on both platforms.
+// RU: Проверяем приватный запрос паузы с ограниченной частотой на обеих платформах.
+bool geany_pause_requested()
+{
+      static unsigned polls = 0;
+      return geany_debug_enabled() && (++polls % 1024 == 0) &&
+            std::remove(".geany-vvp-pause") == 0;
+}
