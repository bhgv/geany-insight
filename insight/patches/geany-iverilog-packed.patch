+// EN: Emit fields from layout against the captured bits and debit remaining rows.
+// RU: Выводит поля из layout по снятым bits и уменьшает лимит remaining.
+static void geany_frame_fields(const std::string& layout, const std::string& bits,
+                               unsigned& remaining)
+{
+      if (bits.empty() || bits.find_first_not_of("01xz") != std::string::npos)
+            return;
+      std::istringstream records(layout);
+      std::string record;
+      if (!std::getline(records, record, ';') || record != std::to_string(bits.size()))
+            return;
+      while (remaining && std::getline(records, record, ';')) {
+            const size_t first = record.find(':');
+            if (!first || first == std::string::npos || first > 512)
+                  continue;
+            const std::string path = record.substr(0, first);
+            if (path.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_$.") !=
+                std::string::npos)
+                  continue;
+            unsigned offset, width;
+            char extra;
+            if (sscanf(record.c_str() + first + 1, "%u:%u%c", &offset, &width, &extra) != 2 ||
+                !width || offset >= bits.size() || width > bits.size() - offset)
+                  continue;
+            printf("GEANY-FRAME-FIELD\t%s\t%u\t%s\n", path.c_str(), offset,
+                   bits.substr(bits.size() - offset - width, width).c_str());
+            --remaining;
+      }
+}
+
+// EN: Collect compiler field layouts declared in scope, keyed by signal name.
+// RU: Собирает описания полей компилятора из scope по именам сигналов.
+static std::map<std::string, std::string> geany_scope_fields(__vpiScope* scope)
+{
+      static const char prefix[] = "@geany-fields:";
+      std::map<std::string, std::string> layouts;
+      for (vpiHandle handle : scope->intern) {
+            if (vpi_get(vpiType, handle) != vpiParameter)
+                  continue;
+            const char* name = vpi_get_str(vpiName, handle);
+            if (!name || std::strncmp(name, prefix, sizeof prefix - 1))
+                  continue;
+            const std::string signal(name + sizeof prefix - 1);
+            s_vpi_value value = {};
+            value.format = vpiStringVal;
+            vpi_get_value(handle, &value);
+            if (value.format == vpiStringVal && value.value.str && std::strlen(value.value.str) <= 16384)
+                  layouts.emplace(signal, value.value.str);
+      }
+      return layouts;
+}
