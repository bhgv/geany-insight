+// EN: Serialize the fields of record into layout at offset under prefix.
+// remaining bounds the number of fields and depth bounds nested records.
+// RU: Записывает поля record в layout со смещением offset и префиксом prefix.
+// remaining ограничивает число полей, depth ограничивает вложенность.
+static void geany_packed_layout(const netstruct_t& record, const std::string& prefix,
+                                unsigned long offset, unsigned depth, unsigned& remaining,
+                                std::string& layout)
+{
+      if (depth == 8)
+            return;
+      unsigned long cursor = record.packed_width();
+      for (const auto& member : record.members()) {
+            if (!remaining)
+                  return;
+            const long width = member.net_type->packed_width();
+            if (width <= 0)
+                  continue;
+            if (!record.union_flag())
+                  cursor -= static_cast<unsigned long>(width);
+            const char* name = member.name.str();
+            if (!name || !*name || std::strspn(name,
+                "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_$") != std::strlen(name))
+                  continue;
+            std::string path = prefix + name;
+            if (path.size() > 512 || layout.size() + path.size() + 32 > 16384)
+                  return;
+            const unsigned long start = offset + (record.union_flag() ? 0 : cursor);
+            layout += path + ":" + std::to_string(start) + ":" + std::to_string(width) + ";";
+            --remaining;
+            if (const auto* nested = dynamic_cast<const netstruct_t*>(member.net_type))
+                  geany_packed_layout(*nested, path + ".", start, depth + 1, remaining, layout);
+      }
+}
+
+// EN: Return debug metadata for the packed value or array element in net.
+// RU: Возвращает отладочные метаданные упакованного значения или элемента net.
+extern "C" const char* ivl_signal_geany_packed_fields(ivl_signal_t net)
+{
+      ivl_type_t type = net->net_type;
+      if (const auto* array = dynamic_cast<const netdarray_t*>(type))
+            type = array->element_type();
+      const auto* record = dynamic_cast<const netstruct_t*>(type);
+      if (!record || !record->packed() || record->members().empty())
+            return nullptr;
+      const long width = record->packed_width();
+      if (width < 1 || width > 4096)
+            return nullptr;
+
+      static std::string layout;
+      layout = std::to_string(width) + ";";
+      unsigned remaining = 128;
+      geany_packed_layout(*record, "", 0, 0, remaining, layout);
+      return remaining == 128 ? nullptr : layout.c_str();
+}
