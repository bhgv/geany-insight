+/* EN: Run command with inherited pipes. Use the shell only for redirection
+ * or a pipeline. RU: Запускает command с унаследованными каналами.
+ * Командная оболочка нужна только для перенаправления или конвейера. */
+#ifdef __MINGW32__
+static int run_windows_helper(const char*command, int use_shell, HANDLE input, HANDLE output)
+{
+      const char* shell = getenv("COMSPEC");
+      if (!shell || !*shell)
+            shell = "cmd.exe";
+      size_t size = strlen(shell) + strlen(command) + 32;
+      char* line = malloc(size);
+      if (!line)
+            return -1;
+      if (use_shell)
+            snprintf(line, size, "\"%s\" /d /s /c \"%s\"", shell, command);
+      else
+            strcpy(line, command);
+
+      STARTUPINFOA startup = {0};
+      PROCESS_INFORMATION child;
+      startup.cb = sizeof startup;
+      startup.dwFlags = STARTF_USESTDHANDLES;
+      startup.hStdInput = input;
+      startup.hStdOutput = output;
+      startup.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+      BOOL started = CreateProcessA(NULL, line, NULL, NULL, TRUE, CREATE_NO_WINDOW,
+                                    NULL, NULL, &startup, &child);
+      DWORD launch_error = started ? ERROR_SUCCESS : GetLastError();
+      free(line);
+      if (!started) {
+            fprintf(stderr, "Cannot start the Icarus helper (Windows error %lu).\n",
+                    (unsigned long)launch_error);
+            return -1;
+      }
+      DWORD status = 1;
+      if (WaitForSingleObject(child.hProcess, INFINITE) == WAIT_OBJECT_0)
+            GetExitCodeProcess(child.hProcess, &status);
+      CloseHandle(child.hThread);
+      CloseHandle(child.hProcess);
+      return (int)status;
+}
+
+/* EN: Run the generated preprocess and compiler commands separately on Windows.
+ * RU: Запускает сгенерированные команды препроцессора и компилятора отдельно в Windows. */
+static int run_windows_compile(const char*command)
+{
+      const char* separator = strstr(command, " |");
+      HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+      HANDLE output = GetStdHandle(STD_OUTPUT_HANDLE);
+      if (!separator)
+            return run_windows_helper(command, 0, input, output);
+
+      char directory[MAX_PATH];
+      char filename[MAX_PATH];
+      DWORD length = GetTempPathA(MAX_PATH, directory);
+      if (!length || length >= MAX_PATH || !GetTempFileNameA(directory, "ivl", 0, filename)) {
+            fprintf(stderr, "Cannot create temporary preprocessed HDL (Windows error %lu).\n",
+                    (unsigned long)GetLastError());
+            return 1;
+      }
+      SECURITY_ATTRIBUTES attributes = {sizeof attributes, NULL, TRUE};
+      HANDLE intermediate = CreateFileA(filename, GENERIC_READ | GENERIC_WRITE, 0, &attributes,
+                                       OPEN_EXISTING, FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, NULL);
+      if (intermediate == INVALID_HANDLE_VALUE) {
+            fprintf(stderr, "Cannot open temporary preprocessed HDL (Windows error %lu).\n",
+                    (unsigned long)GetLastError());
+            DeleteFileA(filename);
+            return 1;
+      }
+
+      size_t size = (size_t)(separator - command);
+      char* preprocess = malloc(size + 1);
+      if (!preprocess) {
+            CloseHandle(intermediate);
+            fprintf(stderr, "Cannot allocate the Icarus preprocessor command.\n");
+            return 1;
+      }
+      memcpy(preprocess, command, size);
+      preprocess[size] = 0;
+      int rc = run_windows_helper(preprocess, 0, input, intermediate);
+      if (rc)
+            fprintf(stderr, "Icarus preprocessing failed (Windows exit code %d).\n", rc);
+      else if (SetFilePointer(intermediate, 0, NULL, FILE_BEGIN) == INVALID_SET_FILE_POINTER) {
+            fprintf(stderr, "Cannot rewind preprocessed HDL (Windows error %lu).\n",
+                    (unsigned long)GetLastError());
+            rc = 1;
+      } else {
+            rc = run_windows_helper(separator + 2, 0, intermediate, output);
+            if (rc)
+                  fprintf(stderr, "Icarus compilation/elaboration failed (Windows exit code %d).\n", rc);
+      }
+      free(preprocess);
+      CloseHandle(intermediate);
+      return rc;
+}
+#endif
+
+/* EN: Execute command, using the shell only when requested by use_shell.
+ * RU: Выполняет command через оболочку только по запросу use_shell. */
+static int run_command(const char*command, int use_shell)
+{
+#ifdef __MINGW32__
+      return run_windows_helper(command, use_shell, GetStdHandle(STD_INPUT_HANDLE),
+                                GetStdHandle(STD_OUTPUT_HANDLE));
+#else
+      (void)use_shell;
+      return system(command);
+#endif
+}
