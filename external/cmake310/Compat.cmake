# Only used for the editor's Linux/Ninja shared Clang SDK on CMake 3.10.
if(POLICY CMP0079)
  cmake_policy(SET CMP0079 NEW)
endif()
if(NOT COMMAND target_link_options)
  function(target_link_options target scope)
    if(NOT scope STREQUAL "PRIVATE")
      message(FATAL_ERROR "CMake 3.10 SDK compatibility only supports PRIVATE link options")
    endif()
    foreach(option IN LISTS ARGN)
      if(option MATCHES "^LINKER:")
        string(REGEX REPLACE "^LINKER:" "-Wl," option "${option}")
      endif()
      set_property(TARGET ${target} APPEND_STRING PROPERTY LINK_FLAGS " ${option}")
    endforeach()
  endfunction()
endif()
if(NOT COMMAND add_compile_definitions)
  function(add_compile_definitions)
    foreach(definition IN LISTS ARGN)
      add_definitions("-D${definition}")
    endforeach()
  endfunction()
endif()
